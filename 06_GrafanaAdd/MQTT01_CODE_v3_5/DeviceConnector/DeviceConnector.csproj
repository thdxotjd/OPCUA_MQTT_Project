    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>3.0.0</Version>
    <Description>DeviceConnector v3.0 - Multi-Device OPC UA + MQTT Bridge Library</Description>
